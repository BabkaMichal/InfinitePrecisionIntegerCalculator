TARGET_64 = calculator.exe
TARGET_32 = calculator.exe

CC = gcc

CFLAGS = -Wall -Wextra -O2

SRCS = $(wildcard *.c)
OBJS = $(SRCS:.c=.o)

all: win64

win64: $(SRCS)
	@echo "64-bit"
	$(CC) $(CFLAGS) -m64 $(SRCS) -o $(TARGET_64)
	@echo "$(TARGET_64)"

win32: $(SRCS)
	@echo "32-bit"
	$(CC) $(CFLAGS) -m32 $(SRCS) -o $(TARGET_32)
	@echo "$(TARGET_32)"

clean:
	@echo "Mazu exe soubory..."
	if exist *.exe del *.exe
	if exist *.o del *.o

.PHONY: all win64 win32 clean